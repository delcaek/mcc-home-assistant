<?xml version="1.0" encoding="utf-8"?>
<!-- targetSdk 22: on Android 6 (API 23) SYSTEM_ALERT_WINDOW is then granted automatically. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.mccha.overlay">
    <uses-sdk android:minSdkVersion="22" android:targetSdkVersion="22"/>
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
    <application android:label="MCC Overlay" android:allowBackup="false">
        <service android:name=".OverlayService" android:exported="true"/>
    </application>
</manifest>
