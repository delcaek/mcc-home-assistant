# Host-side settings for scripts/*.sh and host/*. Copy to config/config.env and edit.
# (192.0.2.x addresses are documentation placeholders - use your own.)

# ADB over Wi-Fi of the machine (give it a fixed DHCP lease)
ADB_ADDR=192.0.2.20:5555
# adb binary (Android platform-tools)
ADB=adb

# MQTT broker used by Home Assistant (same as in config/mcc.json)
MQTT_HOST=192.0.2.10
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=
MQTT_BASE_TOPIC=mcc
DISCOVERY_PREFIX=homeassistant
DEVICE_ID=mcc_skmc1200

# mosquitto client binaries (package "mosquitto-clients"). If your broker runs in Docker you can use e.g.
#   MOSQUITTO_PUB="docker exec -i mosquitto mosquitto_pub"
MOSQUITTO_PUB=mosquitto_pub
MOSQUITTO_SUB=mosquitto_sub

# Where the watchdog keeps its log and flag files (".pause" pauses it)
STATE_DIR=$HOME/.local/state/mcc-ha

# Watchdog tweaks (1 = on). See docs/operations.md.
KEEP_ALL_CORES=1     # MediaTek hotplug keeps only cpu0 online -> sluggish UI
WAKELOCK=1           # kernel wakelock "mcc": prevents deep sleep that freezes the daemon and drops MQTT
CRASHLOG=1           # run device/crashlog.sh on the machine

# Display camera (host/mcc-screen.py): seconds between screenshots while running / while the screen is on
SCREEN_RUNNING_S=5
SCREEN_IDLE_S=60
